<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Build Logic Forum</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; background: #f4f6f9; padding: 20px; color: #1e293b; }
    .container { max-width: 900px; margin: 0 auto; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .card { background: white; border-radius: 12px; padding: 20px; margin-bottom: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .tag-badge { padding: 2px 8px; border-radius: 12px; font-weight: 700; font-size: 0.75rem; border: 1px solid currentColor; }
    .vote-btn { background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 6px; padding: 4px 10px; cursor: pointer; font-weight: bold; }
    .vote-btn:hover { background: #e2e8f0; }
    a { color: #2563eb; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Build Logic Forum</h1>
      <div>
        <% if (user) { %>
          <a href="/user/<%= user.username %>">My Profile (<%= user.username %>)</a> | 
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a> | <a href="/register">Register</a>
        <% } %>
      </div>
    </div>

    <!-- Search Form -->
    <div class="card">
      <form action="/" method="GET" style="display: flex; gap: 10px;">
        <input type="text" name="search" value="<%= search %>" placeholder="Search questions..." style="flex:1; padding:10px; border-radius:8px; border:1px solid #ccc;">
        <button type="submit" style="padding:10px 20px; border-radius:8px; background:#2563eb; color:white; border:none; cursor:pointer;">Search</button>
      </form>
    </div>

    <!-- New Question Form -->
    <% if (user) { %>
      <div class="card">
        <h3>Ask a Question</h3>
        <form action="/questions" method="POST">
          <input type="text" name="title" placeholder="Title" required style="width:100%; padding:10px; margin-bottom:10px; border-radius:8px; border:1px solid #ccc; box-sizing:border-box;"><br>
          <textarea name="body" rows="3" placeholder="Describe your issue... (use /colortext &quot;red&quot; &quot;text&quot; for colored text)" required style="width:100%; padding:10px; margin-bottom:10px; border-radius:8px; border:1px solid #ccc; box-sizing:border-box;"></textarea><br>
          <button type="submit" style="padding:10px 20px; border-radius:8px; background:#2563eb; color:white; border:none; cursor:pointer;">Post Question</button>
        </form>
      </div>
    <% } %>

    <!-- Question List -->
    <h2>Questions</h2>
    <% questions.forEach(q => { %>
      <div class="card" style="display:flex; gap:15px; align-items:center;">
        <form action="/vote" method="POST" style="text-align:center;">
          <input type="hidden" name="target_type" value="question">
          <input type="hidden" name="target_id" value="<%= q.id %>">
          <button type="submit" class="vote-btn">▲ <%= q.upvotes || 0 %></button>
        </form>
        <div style="flex:1;">
          <h3 style="margin:0 0 5px 0;"><a href="/questions/<%= q.id %>"><%= q.title %></a></h3>
          <p style="margin:0; font-size:0.9rem; color:#64748b;">
            Asked by <a href="/user/<%= q.username %>"><strong><%= q.username %></strong></a>
            <% if (q.tag) { %>
              <span class="tag-badge" style="color: <%= q.tag_color || '#3b82f6' %>;"><%= q.tag %></span>
            <% } %>
            • <%= q.answer_count %> answers
          </p>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
