<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Build Logic Forum</title></head>
<body>
  <h1>Build Logic Community Forum</h1>
  <nav>
    <% if (user) { %>
      Logged in as: <a href="/user/<%= user.username %>"><strong><%= user.username %></strong></a> | <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a> | <a href="/register">Register</a>
    <% } %>
    <% if (isAdmin) { %> | <a href="/admin/dashboard" style="color:red;">Admin Dashboard</a><% } %>
  </nav>

  <hr>

  <h2>Search Questions</h2>
  <form action="/" method="GET">
    <input type="text" name="search" placeholder="Search questions..." value="<%= search %>">
    <button type="submit">Search</button>
    <% if (search) { %><a href="/">Clear Filter</a><% } %>
  </form>

  <% if (user) { %>
    <h2>Ask a Question</h2>
    <form action="/questions" method="POST">
      <input type="text" name="title" placeholder="Question Title" required><br><br>
      <textarea name="body" placeholder="Describe your logic puzzle..." required></textarea><br><br>
      <button type="submit">Post Question</button>
    </form>
  <% } %>

  <h2>Recent Questions</h2>
  <ul>
    <% questions.forEach(q => { %>
      <li>
        <a href="/questions/<%= q.id %>"><strong><%= q.title %></strong></a> 
        (Asked by: <a href="/user/<%= q.username %>"><%= q.username %></a>, Answers: <%= q.answer_count %>)
      </li>
    <% }) %>
  </ul>
</body>
</html>
