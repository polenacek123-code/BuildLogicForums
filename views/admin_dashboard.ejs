<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; background: #1e1e2e; color: #cdd6f4; padding: 20px; }
    .card { background: #313244; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { padding: 10px; text-align: left; border-bottom: 1px solid #45475a; }
    input, select, button { padding: 6px 10px; border-radius: 4px; border: none; }
    input, select { background: #45475a; color: white; }
    button { background: #89b4fa; color: #11111b; font-weight: bold; cursor: pointer; }
    .danger { background: #f38ba8; color: #11111b; }
    a { color: #89b4fa; }
    .tag-badge { padding: 2px 6px; border-radius: 4px; font-weight: bold; }
  </style>
</head>
<body>
  <h1>Admin Dashboard</h1>
  <a href="/">← Zpět na fórum</a>

  <div class="card">
    <h2>Správa Uživatelů</h2>
    <table>
      <tr>
        <th>ID</th>
        <th>Uživatel</th>
        <th>Aktuální Tag</th>
        <th>Nastavit Tag a Barvu</th>
        <th>Reset Hesla</th>
        <th>Akce</th>
      </tr>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.id %></td>
          <td><strong><%= u.username %></strong></td>
          <td>
            <% if (u.tag) { %>
              <span class="tag-badge" style="color: <%= u.tag_color || 'white' %>; border: 1px solid <%= u.tag_color || 'white' %>;">
                <%= u.tag %>
              </span>
            <% } else { %>
              <em>Žádný</em>
            <% } %>
          </td>
          <td>
            <form action="/mod/set-user-tag" method="POST" style="display:flex; gap: 5px; align-items: center;">
              <input type="hidden" name="user_id" value="<%= u.id %>">
              <input type="text" name="tag" placeholder="Tag" value="<%= u.tag %>" style="width: 90px;">
              <select name="tag_color">
                <% ['blue', 'red', 'orange', 'yellow', 'green', 'cyan', 'purple', 'pink', 'black', 'grey', 'white', 'gold', 'lime', 'brown', 'lightblue', 'skyblue'].forEach(c => { %>
                  <option value="<%= c %>" <%= u.tag_color === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
              <button type="submit">Uložit</button>
            </form>
          </td>
          <td>
            <form action="/mod/reset-user-pass" method="POST" style="display:flex; gap: 5px;">
              <input type="hidden" name="user_id" value="<%= u.id %>">
              <input type="password" name="new_pass" placeholder="Nové heslo" required style="width: 100px;">
              <button type="submit">Reset</button>
            </form>
          </td>
          <td>
            <form action="/mod/remove-user" method="POST" style="display:inline;">
              <input type="hidden" name="user_id" value="<%= u.id %>">
              <button type="submit" class="danger" onclick="return confirm('Smazat uživatele a veškerý jeho obsah?')">Smazat</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>

  <div class="card">
    <h2>Správa Otázek</h2>
    <table>
      <tr>
        <th>ID</th>
        <th>Název</th>
        <th>Autor</th>
        <th>Akce</th>
      </tr>
      <% questions.forEach(q => { %>
        <tr>
          <td><%= q.id %></td>
          <td><a href="/questions/<%= q.id %>"><%= q.title %></a></td>
          <td><%= q.username %></td>
          <td>
            <form action="/mod/remove-question" method="POST" style="display:inline;">
              <input type="hidden" name="question_id" value="<%= q.id %>">
              <button type="submit" class="danger" onclick="return confirm('Opravdu smazat otázku?')">Smazat</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>
</body>
</html>
