<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><title>Admin Dashboard</title>
  <style>
    body { font-family: sans-serif; padding: 20px; background: #f8fafc; }
    table { width: 100%; border-collapse: collapse; background: white; margin-bottom: 20px; }
    th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; }
    .badge { background-color: #e0e7ff; color: #3730a3; padding: 2px 6px; border-radius: 8px; font-size: 0.8rem; }
  </style>
</head>
<body>
  <a href="/">← Back to Forum</a>
  <h1>Admin Dashboard</h1>

  <h2>Manage Users & Tags</h2>
  <table>
    <tr><th>ID</th><th>Username</th><th>Tag</th><th>Actions / Set Tag</th></tr>
    <% users.forEach(u => { %>
      <tr>
        <td><%= u.id %></td>
        <td><a href="/user/<%= u.username %>"><%= u.username %></a> <% if (u.tag) { %><span class="badge"><%= u.tag %></span><% } %></td>
        <td><%= u.tag || 'None' %></td>
        <td>
          <!-- Nastavení Tagu -->
          <form action="/admin/set-tag" method="POST" style="display:inline-block; margin-right: 15px;">
            <input type="hidden" name="user_id" value="<%= u.id %>">
            <input type="text" name="tag" placeholder="e.g. Creator, Verified" value="<%= u.tag || '' %>">
            <button type="submit">Set Tag</button>
          </form>

          <!-- Smazat uživatele -->
          <form action="/admin/delete-user" method="POST" style="display:inline-block;">
            <input type="hidden" name="user_id" value="<%= u.id %>">
            <button type="submit" onclick="return confirm('Delete user?')" style="color:red;">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>

  <h2>Questions</h2>
  <ul>
    <% questions.forEach(q => { %>
      <li>
        <strong><%= q.title %></strong> (by <%= q.username %>)
        <form action="/admin/delete-question" method="POST" style="display:inline;">
          <input type="hidden" name="question_id" value="<%= q.id %>">
          <button type="submit" onclick="return confirm('Delete?')">Delete</button>
        </form>
      </li>
    <% }) %>
  </ul>
</body>
</html>
